# Build-time variables (Vercel > Project > Settings > Environment Variables).
# NEXT_PUBLIC_* values are baked into the static HTML.

# Form endpoint for the Contact and Wedding inquiry forms. Anything that
# accepts a JSON POST works: Formspree (https://formspree.io/f/xxxx), a
# GoHighLevel inbound webhook, etc. Unset = forms show a "call or email" error.
NEXT_PUBLIC_FORM_ENDPOINT=

# Google Search Console > HTML tag verification. Paste only the content value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
